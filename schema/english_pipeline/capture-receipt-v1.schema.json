{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.kaoyan-english/schema/english_pipeline/capture-receipt-v1.schema.json",
  "title": "Foreground capture receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "capture_id", "status", "original_status", "replayed", "event_path", "event_sha256", "request_sha256", "formal_write_count", "formal_writeback", "supersedes_event_id", "receipt_path", "projection_status", "view_path", "view_sha256", "projection_error"],
  "properties": {
    "schema_version": {"const": "english_capture_receipt_v1"}, "receipt_id": {"type": "string"}, "capture_id": {"type": "string"},
    "status": {"enum": ["created", "idempotent_noop", "capture_saved_but_projection_failed"]}, "original_status": {"const": "created"}, "replayed": {"type": "boolean"},
    "event_path": {"type": "string"}, "event_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "request_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "formal_write_count": {"const": 0}, "formal_writeback": {"const": "none"},
    "supersedes_event_id": {"type": ["string", "null"]}, "receipt_path": {"type": "string"},
    "projection_status": {"enum": ["rendered", "failed"]}, "view_path": {"type": ["string", "null"]},
    "view_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}, "projection_error": {"type": ["string", "null"]}
  }
}
