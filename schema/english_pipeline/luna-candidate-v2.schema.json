{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.kaoyan-english/schema/english_pipeline/luna-candidate-v2.schema.json",
  "title": "English Luna candidate v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "study_date", "source_id", "article_id", "article_source_hash", "created_at", "producer", "runtime_identity", "capture_event_ids", "capture_event_sha256", "evidence_manifest", "sentence_records", "observed_signals", "signal_outcomes", "capture_coverage", "review_exclusion_proposals", "reactivation_proposals", "needs_user_decision", "formal_write_count", "formal_writeback", "validation", "items"],
  "properties": {
    "schema_version": {"const": "english_luna_candidate_v2"},
    "candidate_id": {"type": "string"}, "study_date": {"type": "string", "format": "date"}, "source_id": {"type": "string"}, "article_id": {"type": "string"},
    "article_source_hash": {"$ref": "#/$defs/sha256"}, "created_at": {"type": "string"}, "producer": {"type": "object"}, "runtime_identity": {"type": "object"},
    "capture_event_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "capture_event_sha256": {"type": "object"},
    "evidence_manifest": {"type": "object"}, "sentence_records": {"type": "array", "items": {"$ref": "#/$defs/sentenceRecord"}},
    "observed_signals": {"type": "array", "items": {"type": "object"}}, "signal_outcomes": {"type": "array", "items": {"type": "object"}}, "capture_coverage": {"type": "object"},
    "review_exclusion_proposals": {"type": "array", "items": {"type": "object"}}, "reactivation_proposals": {"type": "array", "items": {"type": "object"}}, "needs_user_decision": {"type": "array", "items": {"type": "object"}},
    "formal_write_count": {"const": 0}, "formal_writeback": {"const": "none"}, "validation": {"type": "object"}, "items": {"type": "array", "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sentenceRecord": {"type": "object", "additionalProperties": false, "required": ["sentence_record_id", "source_event_id", "sequence", "source_sentence", "sentence_hash", "user_first_translation", "corrected_meaning", "explanation", "user_evidence_verbatim"], "properties": {"sentence_record_id": {"type": "string"}, "source_event_id": {"type": "string"}, "sequence": {"type": "integer"}, "source_sentence": {"type": "string"}, "sentence_hash": {"$ref": "#/$defs/sha256"}, "user_first_translation": {"type": ["string", "null"]}, "corrected_meaning": {"type": "string"}, "explanation": {"type": "string"}, "user_evidence_verbatim": {"type": ["string", "null"]}}},
    "item": {"type": "object", "additionalProperties": true, "required": ["item_id", "sequence", "item", "candidate_type", "candidate_status", "tier", "source_event_id", "sentence_record_id", "source_signal_ids", "evidence_states", "evidence_origin", "user_evidence", "bank_status", "bank_match_ids", "mastered_status", "grounding", "card"], "properties": {"item_id": {"type": "string"}, "sequence": {"type": "integer"}, "item": {"type": "string"}, "source_event_id": {"type": "string"}, "sentence_record_id": {"type": "string"}, "source_signal_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "card": {"type": "object", "not": {"anyOf": [{"required": ["source_sentence"]}, {"required": ["source_translation"]}]}}}}
  }
}
