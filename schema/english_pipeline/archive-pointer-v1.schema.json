{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.kaoyan-english/schema/english_pipeline/archive-pointer-v1.schema.json",
  "title": "Local English archive pointer v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "package_sha256", "archive_root", "archive_relative_path", "archive_receipt_path", "archive_locator_path", "display_closure_receipt_id", "display_closure_receipt_path", "display_closure_receipt_sha256", "formal_reference_scan_sha256", "stable_asset_count", "no_display", "pending_component", "created_at"],
  "properties": {
    "schema_version": {"const": "english_archive_pointer_v1"},
    "package_id": {"type": "string"},
    "package_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "archive_root": {"type": "string"},
    "archive_relative_path": {"type": "string"},
    "archive_receipt_path": {"type": "string"},
    "archive_locator_path": {"type": "string"},
    "display_closure_receipt_id": {"type": "string"},
    "display_closure_receipt_path": {"type": "string"},
    "display_closure_receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "formal_reference_scan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "stable_asset_count": {"type": "integer", "minimum": 0},
    "no_display": {"type": "boolean"},
    "support_refresh_receipt_id": {"type": "string"},
    "support_refresh_receipt_path": {"type": "string"},
    "support_refresh_receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "index_snapshot_path": {"type": "string"},
    "index_snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "support_key": {"type": "string"},
    "record_kind": {"enum": ["sentence", "protected_sidecar"]},
    "record_path": {"type": "string"},
    "record_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "old_record_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "new_record_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "published_record_path": {"type": "string"},
    "published_record_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "record_bytes": {"type": "integer", "minimum": 1, "maximum": 12288},
    "resolved_formal_ids": {"type": "array", "items": {"type": "string"}},
    "formal_locator_policy": {"const": "resolve_current_by_id"},
    "dependency_locator_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "pending_component": {"enum": ["cleanup", null]},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
