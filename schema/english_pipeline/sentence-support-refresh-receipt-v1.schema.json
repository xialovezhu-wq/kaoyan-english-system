{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.kaoyan-english/schema/english_pipeline/sentence-support-refresh-receipt-v1.schema.json",
  "title": "English sentence-support refresh receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "batch_id", "study_date", "manifest_path", "manifest_sha256", "writer_receipt_id", "writer_receipt_path", "writer_receipt_sha256", "proposal_id", "proposal_input_sha256", "proposal_path", "proposal_sha256", "support_preflight_receipt_id", "support_preflight_receipt_path", "support_preflight_receipt_sha256", "previous_index_sha256", "index_snapshot_path", "index_snapshot_sha256", "package_closures", "completed_package_ids", "excluded_package_ids", "history_complete_through", "latest_refresh_study_date", "history_coverage_status", "formal_write_count", "background_processing", "completed_at", "receipt_id"],
  "properties": {
    "schema_version": {"const": "english_sentence_support_refresh_receipt_v1"},
    "status": {"const": "PASS"},
    "batch_id": {"type": "string"},
    "study_date": {"type": "string", "format": "date"},
    "manifest_path": {"type": "string"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "writer_receipt_id": {"type": "string"},
    "writer_receipt_path": {"type": "string"},
    "writer_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "proposal_id": {"type": "string"},
    "proposal_input_sha256": {"$ref": "#/$defs/sha256"},
    "proposal_path": {"type": "string"},
    "proposal_sha256": {"$ref": "#/$defs/sha256"},
    "support_preflight_receipt_id": {"type": "string"},
    "support_preflight_receipt_path": {"type": "string"},
    "support_preflight_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "previous_index_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "index_snapshot_path": {"type": "string"},
    "index_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "package_closures": {"type": "array", "items": {"type": "object"}},
    "completed_package_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "excluded_package_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "history_complete_through": {"type": ["string", "null"], "format": "date"},
    "latest_refresh_study_date": {"type": "string", "format": "date"},
    "history_coverage_status": {"enum": ["complete_local_date", "package_subset", "needs_user_excluded"]},
    "formal_write_count": {"const": 0},
    "background_processing": {"const": "none"},
    "completed_at": {"type": "string", "format": "date-time"},
    "receipt_id": {"type": "string", "pattern": "^EN-SUPPORT-[A-F0-9]{16}$"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
