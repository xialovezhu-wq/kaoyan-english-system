{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.kaoyan-english/schema/english_pipeline/archive-cleanup-intent-v1.schema.json",
  "title": "English archive cleanup intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "package_sha256", "local_package_path", "archive_root", "archive_relative_path", "archive_receipt_path", "archive_receipt_sha256", "locator_path", "locator_sha256", "display_closure_receipt_id", "display_closure_receipt_path", "display_closure_receipt_sha256", "formal_reference_scan_sha256", "stable_asset_count", "no_display", "pending_component", "cleanup_authorized", "pointer_created_at"],
  "properties": {
    "schema_version": {"const": "english_archive_cleanup_intent_v1"},
    "package_id": {"type": "string"},
    "package_sha256": {"$ref": "#/$defs/sha256"},
    "local_package_path": {"type": "string"},
    "archive_root": {"type": "string"},
    "archive_relative_path": {"type": "string"},
    "archive_receipt_path": {"type": "string"},
    "archive_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "locator_path": {"type": "string"},
    "locator_sha256": {"$ref": "#/$defs/sha256"},
    "display_closure_receipt_id": {"type": "string"},
    "display_closure_receipt_path": {"type": "string"},
    "display_closure_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "formal_reference_scan_sha256": {"$ref": "#/$defs/sha256"},
    "stable_asset_count": {"type": "integer", "minimum": 0},
    "no_display": {"type": "boolean"},
    "support_refresh_receipt_id": {"type": "string"},
    "support_refresh_receipt_path": {"type": "string"},
    "support_refresh_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "index_snapshot_path": {"type": "string"},
    "index_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "support_key": {"type": "string"},
    "record_kind": {"enum": ["sentence", "protected_sidecar"]},
    "record_path": {"type": "string"},
    "record_sha256": {"$ref": "#/$defs/sha256"},
    "old_record_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "new_record_sha256": {"$ref": "#/$defs/sha256"},
    "published_record_path": {"type": "string"},
    "published_record_sha256": {"$ref": "#/$defs/sha256"},
    "record_bytes": {"type": "integer", "minimum": 1, "maximum": 12288},
    "resolved_formal_ids": {"type": "array", "items": {"type": "string"}},
    "formal_locator_policy": {"const": "resolve_current_by_id"},
    "dependency_locator_sha256": {"$ref": "#/$defs/sha256"},
    "pending_component": {"const": "cleanup"},
    "cleanup_authorized": {"const": true},
    "pointer_created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
